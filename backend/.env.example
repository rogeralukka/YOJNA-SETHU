PORT=8000
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yojanasetu?schema=public"

# JWT Auth Secrets
JWT_ACCESS_SECRET=your-super-secret-jwt-access-token-key-change-in-prod
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-change-in-prod
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Hackathon / Privacy Demo Mode
DEMO_MODE=true

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# External Integrations (Optional / Mocked in Demo Mode)
RESEND_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
API_SETU_CLIENT_ID=
API_SETU_CLIENT_SECRET=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
