# ==============================================================================
# Government Scheme Portal - Complete Production Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000
UPLOAD_DIR=uploads

# Database Configuration (Prisma ORM)
# Local SQLite Default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL Example:
# DATABASE_URL="postgresql://gov_user:SecurePassword123@localhost:5432/gov_scheme_portal?schema=public"

# Security & JWT
JWT_SECRET=super_secret_gov_portal_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 1. Transactional Email Gateway (SMTP / SendGrid / AWS SES / Gmail)
# ------------------------------------------------------------------------------
# Leave blank for local development / testing fallback mode
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_or_smtp_password
EMAIL_FROM="Government Scheme Portal <noreply@gov.in>"

# ------------------------------------------------------------------------------
# 2. SMS & Mobile OTP Gateway (Twilio & Fast2SMS)
# ------------------------------------------------------------------------------
# Twilio Global SMS Configuration:
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS (Indian SMS Gateway) Configuration:
FAST2SMS_API_KEY=your_fast2sms_api_key

# ------------------------------------------------------------------------------
# 3. Cloud Object Storage (AWS S3 / Cloudflare R2 / MinIO / GCS)
# ------------------------------------------------------------------------------
# Leave blank for local /uploads directory disk storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=gov-scheme-portal-documents
# Optional Custom S3 Endpoint (for Cloudflare R2 / MinIO):
# AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=cdn.schemes.gov.in

# ------------------------------------------------------------------------------
# 4. National DigiLocker API Integration
# ------------------------------------------------------------------------------
DIGILOCKER_CLIENT_ID=your_digilocker_partner_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_partner_client_secret
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/digilocker/callback
# Set to 'false' in production with government live credentials:
DIGILOCKER_SANDBOX=true
DIGILOCKER_API_BASE_URL=https://digilocker.meripehchaan.gov.in
