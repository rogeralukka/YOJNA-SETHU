datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntityType {
  PERSONAL
  BUSINESS
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  SCHEME_ADDED
  SCHEME_UPDATED
}

enum SchemeType {
  PERSONAL
  BUSINESS
  BOTH
}

enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  OUTDATED
  ARCHIVED
}

enum SchemeStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
  ARCHIVED
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum DocumentType {
  AADHAAR
  PAN
  INCOME_CERTIFICATE
  CASTE_CERTIFICATE
  LAND_DOCUMENT
  BANK_ACCOUNT
  BUSINESS_REGISTRATION
  UDYAM_CERTIFICATE
  OTHER
}

model User {
  id                String         @id @default(cuid())
  userId            String         @unique @default(cuid())
  name              String
  email             String         @unique
  phone             String         @unique
  passwordHash      String
  role              Role           @default(USER)
  age               Int?
  state             String?
  category          String?
  annualIncome      Float?
  profileComplete   Boolean        @default(false)
  profilePictureUrl String?
  aadhaarLast4      String?
  aadhaarVerified   Boolean        @default(false)
  panLast4          String?
  panVerified       Boolean        @default(false)
  bankName          String?
  bankAccountLast4  String?
  bankIfsc          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lastLoginAt       DateTime?
  isActive          Boolean        @default(true)

  refreshTokens     RefreshToken[]
  businessCards     BusinessCard[]
  applications      Application[]
  notifications     Notification[]
  bookmarks         Bookmark[]

  @@index([email])
  @@index([phone])
}

model RefreshToken {
  id              String   @id @default(cuid())
  token           String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  isRevoked       Boolean  @default(false)
  replacedByToken String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model BusinessCard {
  id                      String        @id @default(cuid())
  cardId                  String        @unique @default(cuid())
  userId                  String
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName            String
  businessType            String
  gstNumberMasked         String?
  panLast4                String?
  address                 String
  phone                   String
  email                   String
  annualTurnover          Float
  employeeCount           Int
  industryCategory        String
  yearsInOperation        Int
  udyamRegistrationMasked String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  applications            Application[]

  @@index([userId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  ministry    String?
  officialUrl String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schemes     Scheme[]

  @@index([slug])
  @@index([name])
}

model SchemeCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schemes     Scheme[]

  @@index([slug])
  @@index([name])
}

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schemeStates SchemeState[]

  @@index([code])
}

model EligibilityCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schemeEligibilities SchemeCategoryEligibility[]

  @@index([code])
}

model Scheme {
  id                     String                      @id @default(cuid())
  schemeId               String                      @unique
  name                   String
  slug                   String                      @unique
  shortDescription       String
  description            String
  departmentId           String
  department             Department                  @relation(fields: [departmentId], references: [id])
  categoryId             String
  category               SchemeCategory              @relation(fields: [categoryId], references: [id])
  schemeType             SchemeType                  @default(PERSONAL)
  isBusinessScheme       Boolean                     @default(false)
  eligibilityDescription String?
  minAge                 Int?
  maxAge                 Int?
  minIncome              Float?
  maxIncome              Float?
  rulesJson              Json?
  deadline               DateTime?
  isActive               Boolean                     @default(true)
  isNew                  Boolean                     @default(true)
  status                 SchemeStatus                @default(ACTIVE)
  sourceName             String?
  sourceUrl              String?
  sourceIdentifier       String?
  lastVerifiedAt         DateTime?
  verificationStatus     VerificationStatus          @default(UNVERIFIED)
  versionNumber          Int                         @default(1)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  states                 SchemeState[]
  eligibilityCategories  SchemeCategoryEligibility[]
  documentRequirements   SchemeDocumentRequirement[]
  additionalFields       SchemeAdditionalField[]
  translations           SchemeTranslation[]
  versions               SchemeVersion[]
  bookmarks              Bookmark[]

  @@index([name])
  @@index([slug])
  @@index([categoryId])
  @@index([departmentId])
  @@index([schemeType])
  @@index([status])
  @@index([deadline])
  @@index([isNew])
  @@index([createdAt])
  @@index([updatedAt])
}

model SchemeState {
  id        String   @id @default(cuid())
  schemeId  String
  scheme    Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  stateId   String
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([schemeId, stateId])
  @@index([schemeId])
  @@index([stateId])
}

model SchemeCategoryEligibility {
  id         String              @id @default(cuid())
  schemeId   String
  scheme     Scheme              @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  categoryId String
  category   EligibilityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())

  @@unique([schemeId, categoryId])
  @@index([schemeId])
  @@index([categoryId])
}

model SchemeDocumentRequirement {
  id              String       @id @default(cuid())
  schemeId        String
  scheme          Scheme       @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  documentType    DocumentType
  documentName    String
  description     String?
  isMandatory     Boolean      @default(true)
  acceptedFormats Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([schemeId])
  @@index([documentType])
}

model SchemeAdditionalField {
  id              String    @id @default(cuid())
  schemeId        String
  scheme          Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  fieldKey        String
  label           String
  description     String?
  fieldType       FieldType
  isRequired      Boolean   @default(false)
  validationRules Json?
  options         Json?
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([schemeId])
  @@index([fieldKey])
}

model SchemeTranslation {
  id                     String   @id @default(cuid())
  schemeId               String
  scheme                 Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  languageCode           String
  name                   String
  shortDescription       String
  description            String
  eligibilityDescription String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([schemeId, languageCode])
  @@index([schemeId])
  @@index([languageCode])
}

model SchemeVersion {
  id            String   @id @default(cuid())
  schemeId      String
  scheme        Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json
  changedBy     String?
  changeReason  String?
  createdAt     DateTime @default(now())

  @@index([schemeId])
  @@index([versionNumber])
}

model Application {
  id                String            @id @default(cuid())
  applicationId     String            @unique @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessCardId    String?
  businessCard      BusinessCard?     @relation(fields: [businessCardId], references: [id], onDelete: SetNull)
  schemeIds         Json
  entityType        EntityType
  status            ApplicationStatus @default(PENDING)
  additionalDetails Json?
  adminComment      String?
  appliedAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  approvedAt        DateTime?
  rejectedAt        DateTime?

  @@index([userId])
  @@index([status])
  @@index([businessCardId])
}

model Notification {
  id             String           @id @default(cuid())
  notificationId String           @unique @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemeId  String
  scheme    Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, schemeId])
  @@index([userId])
  @@index([schemeId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}
