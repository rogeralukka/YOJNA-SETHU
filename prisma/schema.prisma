generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  fullName          String
  email             String         @unique
  mobile            String         @unique
  password          String
  role              String         @default("user") // "user" | "admin" | "super_admin"
  
  // Profile Fields
  category          String?        // General, OBC, SC, ST, EWS
  state             String?
  annualIncome      Float?
  age               Int?
  gender            String?        @default("All") // Male, Female, Other, All
  
  // Bank Details
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  bankName          String?
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  documents         Document[]
  businessCards     BusinessCard[]
  applications      Application[]
  bookmarks         Bookmark[]
  notifications     Notification[]
}

model Document {
  id         String   @id @default(uuid())
  userId     String
  docType    String   // aadhaar, pan, voter_id, income_cert, caste_cert, other
  fileName   String
  fileUrl    String
  mimeType   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessCard {
  id               String        @id @default(uuid())
  userId           String
  name             String
  type             String        // Manufacturing, Services, Retail, Agriculture, etc.
  gstNumber        String?
  panNumber        String?
  address          String
  phone            String
  email            String
  turnover         String        // <1L, 1L-10L, 10L-50L, 50L-1Cr, >1Cr
  employeeCount    String        // 1-10, 11-50, 51-200, >200
  industryCategory String        // Textiles, IT, Food Processing, etc.
  yearsInOperation String        // <1, 1-3, 3-5, 5-10, >10
  udyamNumber      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications     Application[]
}

model Scheme {
  id                String        @id @default(uuid())
  name              String
  department        String
  category          String        // Education, Health, Finance, Agriculture, Women & Child, MSME, Entrepreneurship, etc.
  description       String
  
  // Eligibility criteria
  minAge            Int?          @default(0)
  maxAge            Int?          @default(100)
  states            String        @default("[\"All\"]") // JSON array string
  categories        String        @default("[\"All\"]") // JSON array string
  maxIncome         Float?
  targetGender      String?       @default("All") // All, Female, Male
  businessTypes     String?       @default("[\"All\"]") // JSON array string
  isBusinessScheme  Boolean       @default(false)
  
  deadline          DateTime?
  documentsRequired String        @default("[]") // JSON array string
  benefits          String?
  officialUrl       String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  applications      Application[]
  bookmarks         Bookmark[]
}

model Application {
  id             String        @id @default(uuid())
  userId         String
  schemeId       String
  entity         String        @default("personal") // "personal" | "business"
  businessCardId String?
  status         String        @default("pending") // "pending" | "approved" | "rejected"
  adminComment   String?
  snapshotData   String        // JSON string frozen at application time
  appliedAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheme         Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  businessCard   BusinessCard? @relation(fields: [businessCardId], references: [id], onDelete: SetNull)
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  schemeId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheme    Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([userId, schemeId])
}

model Notification {
  id                   String   @id @default(uuid())
  userId               String
  title                String
  message              String
  type                 String   // "application_submitted" | "application_approved" | "application_rejected" | "scheme_added" | "scheme_updated" | "system"
  relatedSchemeId      String?
  relatedApplicationId String?
  isRead               Boolean  @default(false)
  createdAt            DateTime @default(now())

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // "USER_LOGIN" | "ADMIN_LOGIN" | "APPLICATION_APPROVED" | "APPLICATION_REJECTED" | "SCHEME_CREATED" | "SCHEME_UPDATED" | "SCHEME_DELETED"
  details   String?  // JSON or summary description
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}
